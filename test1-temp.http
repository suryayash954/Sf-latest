    "auditRunID": "YOUR_AUDIT_RUN_ID",
    "minRiskScore": 5,
    "top": 20,
    "skip": 0
}

### Get Inactive Users With Access
POST {{baseUrl}}/SuccessFactorRBPReport/getInactiveUsersWithAccess
Content-Type: application/json

{
    "auditRunID": "YOUR_AUDIT_RUN_ID",
    "top": 20,
    "skip": 0
}

### Get Role Details
POST {{baseUrl}}/SuccessFactorRBPReport/getRoleDetails
Content-Type: application/json

{
    "auditRunID": "YOUR_AUDIT_RUN_ID",
    "top": 20,
    "skip": 0
}

### Get Role Coverage Analysis
POST {{baseUrl}}/SuccessFactorRBPReport/getRoleCoverageAnalysis
Content-Type: application/json

{
    "auditRunID": "YOUR_AUDIT_RUN_ID"
}

### Get Group Role Matrix
POST {{baseUrl}}/SuccessFactorRBPReport/getGroupRoleMatrix
Content-Type: application/json

{
    "auditRunID": "YOUR_AUDIT_RUN_ID",
    "top": 50,
    "skip": 0
}

### Get User Role Matrix
POST {{baseUrl}}/SuccessFactorRBPReport/getUserRoleMatrix
Content-Type: application/json

{
    "auditRunID": "YOUR_AUDIT_RUN_ID",
    "top": 50,
    "skip": 0
}

### ============================================
### 6. DELETE AUDIT RUN (Cleanup)
### ============================================

### Delete audit run and all related data
POST {{baseUrl}}/SuccessFactorRBPAudit/deleteAuditRun
Content-Type: application/json

{
    "auditRunID": "YOUR_AUDIT_RUN_ID"
}

### ============================================
### 7. COMPLETE WORKFLOW TEST
### ============================================

### Step 1: Get available instances
GET {{baseUrl}}/SuccessFactorRBPAudit/getAvailableInstances()
Content-Type: application/json

### Step 2: Sync users
POST {{baseUrl}}/SuccessFactorRBPAudit/syncUsers
Content-Type: application/json

{
    "instance": "successfactors"
}

### Step 3: Create audit run (SAVE THE ID FROM RESPONSE)
POST {{baseUrl}}/SuccessFactorRBPAudit/AuditRuns
Content-Type: application/json

{
    "name": "Workflow Test Local",
    "mode": "SAMPLE",
    "instance": "successfactors",
    "extractGroups": true,
    "extractRoles": false,
    "sampleGroupSize": 3,
    "sampleMemberSize": 5,
    "sampleRoleSize": 0
}

### Step 4: Check status (replace ID)
GET {{baseUrl}}/SuccessFactorRBPAudit/getAuditStatus(auditRunID=YOUR_ID)
Content-Type: application/json

### Step 5: Wait 30 seconds, then check status again
GET {{baseUrl}}/SuccessFactorRBPAudit/getAuditStatus(auditRunID=YOUR_ID)
Content-Type: application/json

### Step 6: View results
GET {{baseUrl}}/SuccessFactorRBPAudit/Groups?$filter=auditRunID_ID eq 'YOUR_ID'&$top=10
Content-Type: application/json

### Step 7: Get Risk Dashboard
POST {{baseUrl}}/SuccessFactorRBPReport/getRiskDashboard
Content-Type: application/json

{
    "auditRunID": "YOUR_ID"
}

### Step 8: Delete audit run (cleanup)
POST {{baseUrl}}/SuccessFactorRBPAudit/deleteAuditRun
Content-Type: application/json

{
    "auditRunID": "YOUR_ID"
}