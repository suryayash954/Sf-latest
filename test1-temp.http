### ============================================
### SUCCESSFACTORS PERMISSION AUDIT - COMPLETE TEST SUITE
### Base URL: http://localhost:4004
### ============================================

@baseUrl = http://localhost:4004

### ============================================
### 1. INSTANCE MANAGEMENT
### ============================================

### 1.1 Get available instances (value help for UI)
GET {{baseUrl}}/SuccessFactorRBPAudit/getAvailableInstances()
Content-Type: application/json

### 1.2 Debug connection (test SF connectivity)
POST {{baseUrl}}/SuccessFactorRBPAudit/debugConnection
Content-Type: application/json

{
    "instance": "successfactors"
}

### ============================================
### 2. USER MANAGEMENT
### ============================================

### 2.1 Sync users (first time - fetches all users)
POST {{baseUrl}}/SuccessFactorRBPAudit/syncUsers
Content-Type: application/json

{
    "instance": "successfactors"
}

### 2.2 Sync users again (should return alreadySynced = true)
POST {{baseUrl}}/SuccessFactorRBPAudit/syncUsers
Content-Type: application/json

{
    "instance": "successfactors"
}

### 2.3 Incremental sync (only users modified after date)
POST {{baseUrl}}/SuccessFactorRBPAudit/syncUsersIncremental
Content-Type: application/json

{
    "instance": "successfactors",
    "lastSyncDate": "2026-01-01T00:00:00.000Z"
}

### 2.4 Get all users (paginated)
POST {{baseUrl}}/SuccessFactorRBPAudit/getUsers
Content-Type: application/json

{
    "top": 20,
    "skip": 0
}

### 2.5 Get users by instance
POST {{baseUrl}}/SuccessFactorRBPAudit/getUsers
Content-Type: application/json

{
    "top": 20,
    "skip": 0,
    "instance": "successfactors"
}

### 2.6 Get users with filters
POST {{baseUrl}}/SuccessFactorRBPAudit/getUsers
Content-Type: application/json

{
    "top": 10,
    "skip": 0,
    "instance": "successfactors",
    "status": "active",
    "search": "admin"
}

### 2.7 Direct OData - Get Users
GET {{baseUrl}}/SuccessFactorRBPAudit/Users?$top=10&$filter=instance eq 'successfactors'
Content-Type: application/json

### ============================================
### 3. AUDIT RUN MANAGEMENT
### ============================================

### 3.1 Create FULL Audit Run (Groups + Members only)
POST {{baseUrl}}/SuccessFactorRBPAudit/AuditRuns
Content-Type: application/json

{
    "name": "FULL AUDIT - Groups Only",
    "description": "Complete audit of all groups and members",
    "mode": "FULL",
    "instance": "successfactors",
    "extractGroups": true,
    "extractRoles": false,
    "sampleGroupSize": 0,
    "sampleMemberSize": 0,
    "sampleRoleSize": 0
}

### 3.2 Create SAMPLE Audit Run (for quick testing)
POST {{baseUrl}}/SuccessFactorRBPAudit/AuditRuns
Content-Type: application/json

{
    "name": "SAMPLE AUDIT - Quick Test",
    "description": "Sample audit with limited data",
    "mode": "SAMPLE",
    "instance": "successfactors",
    "extractGroups": true,
    "extractRoles": false,
    "sampleGroupSize": 3,
    "sampleMemberSize": 5,
    "sampleRoleSize": 0
}

### 3.3 Create FULL Audit Run with Roles (if roles accessible)
POST {{baseUrl}}/SuccessFactorRBPAudit/AuditRuns
Content-Type: application/json

{
    "name": "FULL AUDIT - With Roles",
    "description": "Complete audit including roles",
    "mode": "FULL",
    "instance": "successfactors",
    "extractGroups": true,
    "extractRoles": false,
    "sampleGroupSize": 0,
    "sampleMemberSize": 0,
    "sampleRoleSize": 0
}

### 3.4 Get Audit Status (Replace YOUR_ID with actual ID)
GET {{baseUrl}}/SuccessFactorRBPAudit/getAuditStatus(auditRunID=YOUR_ID)
Content-Type: application/json

### 3.5 Get Audit Status using POST
POST {{baseUrl}}/SuccessFactorRBPAudit/getAuditStatus
Content-Type: application/json

{
    "auditRunID": "c96a86e3-cd38-48c9-bda1-82ce9c1d1df1"
}

### 3.6 List all audit runs
GET {{baseUrl}}/SuccessFactorRBPAudit/listAuditRuns
Content-Type: application/json

{
    "top": 20,
    "skip": 0
}

### 3.7 List audit runs filtered by instance
GET {{baseUrl}}/SuccessFactorRBPAudit/listAuditRuns
Content-Type: application/json

{
    "status": "COMPLETED",
    "instance": "successfactors",
    "top": 10,
    "skip": 0
}

### 3.8 Direct OData - Get Audit Runs
GET {{baseUrl}}/SuccessFactorRBPAudit/AuditRuns?$top=10&$orderby=createdAt desc
Content-Type: application/json

### ============================================
### 4. DATA VERIFICATION (After Audit Run)
### ============================================

### 4.1 Get Groups for audit run (Replace YOUR_ID)
GET {{baseUrl}}/SuccessFactorRBPAudit/Groups?$filter=auditRunID_ID eq 'c96a86e3-cd38-48c9-bda1-82ce9c1d1df1'&$top=20
Content-Type: application/json

### 4.2 Get Group Members
GET {{baseUrl}}/SuccessFactorRBPAudit/GroupMembers?$filter=auditRunID_ID eq '23faf2af-8fa0-4b51-b13c-e646a7b000d9'&$top=50
Content-Type: application/json

### 4.3 Get Roles (if extracted)
GET {{baseUrl}}/SuccessFactorRBPAudit/Roles?$filter=auditRunID_ID eq '23faf2af-8fa0-4b51-b13c-e646a7b000d9'&$top=20
Content-Type: application/json

### 4.4 Get Role Target Populations
GET {{baseUrl}}/SuccessFactorRBPAudit/RoleTargetPopulations?$filter=auditRunID_ID eq '23faf2af-8fa0-4b51-b13c-e646a7b000d9'&$top=20
Content-Type: application/json

### 4.5 Get User Role Mappings
GET {{baseUrl}}/SuccessFactorRBPAudit/UserRoleMappings?$filter=auditRunID_ID eq 'YOUR_ID'&$top=20
Content-Type: application/json

### 4.6 Get Multi-Group Users (Risk Analysis)
GET {{baseUrl}}/SuccessFactorRBPAudit/MultiGroupUsers?$filter=auditRunID_ID eq 'YOUR_ID'&$top=20
Content-Type: application/json

### 4.7 Get Inactive Users with Access
GET {{baseUrl}}/SuccessFactorRBPAudit/InactiveUserAccess?$filter=auditRunID_ID eq 'YOUR_ID'&$top=20
Content-Type: application/json

### 4.8 Get Group Size Distribution
GET {{baseUrl}}/SuccessFactorRBPAudit/GroupSizeDistribution?$filter=auditRunID_ID eq '23faf2af-8fa0-4b51-b13c-e646a7b000d9'
Content-Type: application/json

### 4.9 Get Static vs Dynamic Groups
GET {{baseUrl}}/SuccessFactorRBPAudit/StaticVsDynamicGroups?$filter=auditRunID_ID eq '23faf2af-8fa0-4b51-b13c-e646a7b000d9'
Content-Type: application/json

### 4.10 Get User Group Count Distribution
GET {{baseUrl}}/SuccessFactorRBPAudit/UserGroupCountDistribution?$filter=auditRunID_ID eq '23faf2af-8fa0-4b51-b13c-e646a7b000d9'
Content-Type: application/json

### 4.11 Get Unused Roles
GET {{baseUrl}}/SuccessFactorRBPAudit/UnusedRoles?$filter=auditRunID_ID eq '23faf2af-8fa0-4b51-b13c-e646a7b000d9'
Content-Type: application/json

### 4.12 Get Executive Summary
GET {{baseUrl}}/SuccessFactorRBPAudit/ExecutiveSummary?$filter=auditRunID_ID eq '23faf2af-8fa0-4b51-b13c-e646a7b000d9'
Content-Type: application/json

