### ============================================
### 1. GET AVAILABLE INSTANCES
### ============================================

GET {{baseUrl}}/SuccessFactorRBPAudit/getAvailableInstances()
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### ============================================
### 2. SYNC USERS (First time - will fetch all users)
### ============================================

POST {{baseUrl}}/SuccessFactorRBPAudit/syncUsers
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "instance": "successfactors"
}

### ============================================
### 3. CREATE AUDIT RUN (WITHOUT ROLES - SAMPLE MODE)
### ============================================

POST {{baseUrl}}/SuccessFactorRBPAudit/AuditRuns
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "name": "Cloud Audit",
    "description": "Testing audit without roles in cloud",
    "mode": "SAMPLE",
    "instance": "successfactors",
    "extractGroups": true,
    "extractRoles": false,
    "sampleGroupSize": 3,
    "sampleMemberSize": 5,
    "sampleRoleSize": 0
}

### ============================================
### 4. CREATE AUDIT RUN (WITHOUT ROLES - FULL MODE)
### ============================================

POST {{baseUrl}}/SuccessFactorRBPAudit/AuditRuns
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "name": "Cloud Full Audit - No Roles",
    "description": "Complete groups audit without roles",
    "mode": "FULL",
    "instance": "successfactors",
    "extractGroups": true,
    "extractRoles": false,
    "sampleGroupSize": 0,
    "sampleMemberSize": 0,
    "sampleRoleSize": 0
}

### ============================================
### 5. GET AUDIT STATUS (Replace YOUR_AUDIT_RUN_ID)
### ============================================

POST {{baseUrl}}//SuccessFactorRBPAudit/getAuditStatus
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "auditRunID": "ca6bffc5-f274-4f2b-b971-2f4a9b49e340"
}

### ============================================
### 6. LIST ALL AUDIT RUNS
### ============================================

POST {{baseUrl}}/SuccessFactorRBPAudit/listAuditRuns
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "top": 20,
    "skip": 0
}

### ============================================
### 7. GET USERS
### ============================================

POST {{baseUrl}}/SuccessFactorRBPAudit/getUsers
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "top": 10,
    "skip": 0,
    "instance": "successfactors"
}

### ============================================
### 8. VIEW GROUPS FOR AUDIT RUN (Replace YOUR_AUDIT_RUN_ID)
### ============================================

GET {{baseUrl}}/SuccessFactorRBPAudit/Groups?$filter=auditRunID_ID eq 'YOUR_AUDIT_RUN_ID'&$top=10
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### ============================================
### 9. VIEW GROUP MEMBERS (Replace YOUR_AUDIT_RUN_ID)
### ============================================

GET {{baseUrl}}/SuccessFactorRBPAudit/GroupMembers?$filter=auditRunID_ID eq 'YOUR_AUDIT_RUN_ID'&$top=20
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### ============================================
### 10. GET RISK DASHBOARD (Replace YOUR_AUDIT_RUN_ID)
### ============================================

GET {{baseUrl}}/SuccessFactorRBPReport/getRiskDashboard
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "auditRunID": "85b6a28a-471a-439a-bcc5-7ac6cdb54843"
}

### ============================================
### 11. GET EXECUTIVE SUMMARY (Replace YOUR_AUDIT_RUN_ID)
### ============================================

POST {{baseUrl}}/SuccessFactorRBPReport/getExecutiveSummary
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "auditRunID": "becc5f76-9309-4911-94fb-53aaf081631f"
}

### ============================================
### 12. DELETE AUDIT RUN (Replace YOUR_AUDIT_RUN_ID)
### ============================================

POST {{baseUrl}}/SuccessFactorRBPAudit/deleteAuditRun
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "auditRunID": "YOUR_AUDIT_RUN_ID"
}

### ============================================
### 13. DIRECT OData QUERIES
### ============================================

### Get all Audit Runs
GET {{baseUrl}}/SuccessFactorRBPAudit/AuditRuns?$top=5&$orderby=createdAt desc
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### Get Users by instance
GET {{baseUrl}}/SuccessFactorRBPAudit/Users?$filter=instance eq 'successfactors'&$top=5
Authorization: Bearer {{accessToken}}
Content-Type: application/json